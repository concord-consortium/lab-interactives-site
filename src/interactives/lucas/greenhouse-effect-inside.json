      "labels": 0,
      "units": false,
      "gridLines": 10,
      "labelFormat": "0.1f",
      "barWidth": "2em",
      "height": "100%",
      "barColor": "#e23c34",
      "fillColor": "#fff",
      "tooltip": ""
    },
    {
      "id": "inside-air-thermometer",
      "type": "barGraph",
      "property": "insideAirAverageTemperature",
      "min": 0,
      "max": 3000,
      "title": "Inside Air Temperature",
      "titleOn": "right",
      "labels": 0,
      "units": false,
      "gridLines": 10,
      "labelFormat": "0.1f",
      "barWidth": "2em",
      "height": "100%",
      "barColor": "#e23c34",
      "fillColor": "#fff",
      "tooltip": ""
    },
    {
      "id": "outside-wall-thermometer",
      "type": "barGraph",
      "property": "outsideWallAverageTemperature",
