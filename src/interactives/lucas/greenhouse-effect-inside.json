{
  "title": "Greenhouse Effect",
  "publicationStatus": "public",
  "subtitle": "Explore how light interacts with glass and brick walls",
  "aspectRatio": 1.7,
  "fontScale": 0.8,
  "helpOnLoad": false,
  "about": "Note: When loading the *Infrared on CO₂* model the infrared coming from the bottom of the model is emitted from the ground.",
  "models": [
    {
      "type": "md2d",
      "id": "brick",
      "url": "models/lab-version/1/md2d/lucas/greenhouse-effect/greenhouse-effect-brick-inside.json",
      "onLoad": [
        "var outsideWallAtoms = [];",
        "var insideWallAtoms = [];",
        "var airAtoms = [];",
        "for (var i = 0; i < getNumberOfAtoms(); i++) {",
        "  if (getAtomProperties(i).element == 1) {",
        "    outsideWallAtoms.push(i);",
        "  } else if(getAtomProperties(i).element == 3) {",
        "    insideWallAtoms.push(i);",
        "  } else if(getAtomProperties(i).element == 2) {",
        "    airAtoms.push(i);",
        "  }",
        "}",
        "set('outsideWallAtoms', outsideWallAtoms);",
        "set('insideWallAtoms', insideWallAtoms);",
        "setTemperatureOfAtoms(outsideWallAtoms,get('outsideAirTemperature'));",
        "setTemperatureOfAtoms(insideWallAtoms,get('outsideAirTemperature'));",
        "setTemperatureOfAtoms(airAtoms,get('outsideAirTemperature'));",
        "callEvery(200, function() {",
        "  var outsideAtoms = get('outsideAirAtoms');",
        "  var targetTemperature = get('outsideAirTemperature');",
        "  // I'm not really sure what should be in the batch",
        "  batch(function() {",
        "    // This will force the outside air to match a specific temperature",
        "    // Instead we might want to adjust the temperature more slowly over time",
        "    // So it is more like a constant heating/cooling process",
        "    var outsideTemperature = getTemperatureOfAtoms(outsideAtoms);",
        "    var rescalingFactor = Math.sqrt(targetTemperature / outsideTemperature);",
        "    for (var i = 0; i < outsideAtoms.length; i++) {",
        "      var props = getAtomProperties(outsideAtoms[i]);",
        "      var newVx = props.vx * rescalingFactor;",
        "      var newVy = props.vy * rescalingFactor;",
        "      setAtomProperties(outsideAtoms[i], { vx: newVx, vy: newVy });",
        "    }",
        "  });",
        "});"

      ],
      "viewOptions": {
        "controlButtons": "play_reset"
      }
    },
    {
      "type": "md2d",
      "id": "glass",
      "url": "models/lab-version/1/md2d/lucas/greenhouse-effect/greenhouse-effect-glass-inside.json",
      "onLoad": [
        "var outsideWallAtoms = [];",
        "var insideWallAtoms = [];",
        "var airAtoms = [];",
        "for (var i = 0; i < getNumberOfAtoms(); i++) {",
        "  if (getAtomProperties(i).element == 1) {",
        "    outsideWallAtoms.push(i);",
        "  } else if(getAtomProperties(i).element == 3) {",
        "    insideWallAtoms.push(i);",
        "  } else if(getAtomProperties(i).element == 2) {",
        "    airAtoms.push(i);",
        "  }",
        "}",
        "set('outsideWallAtoms', outsideWallAtoms);",
        "set('insideWallAtoms', insideWallAtoms);",
        "setTemperatureOfAtoms(outsideWallAtoms,get('outsideAirTemperature'));",
        "setTemperatureOfAtoms(insideWallAtoms,get('outsideAirTemperature'));",
        "setTemperatureOfAtoms(airAtoms,get('outsideAirTemperature'));",
        "callEvery(200, function() {",
        "  var outsideAtoms = get('outsideAirAtoms');",
        "  var targetTemperature = get('outsideAirTemperature');",
        "  // I'm not really sure what should be in the batch",
        "  batch(function() {",
        "    // This will force the outside air to match a specific temperature",
        "    // Instead we might want to adjust the temperature more slowly over time",
        "    // So it is more like a constant heating/cooling process",
        "    var outsideTemperature = getTemperatureOfAtoms(outsideAtoms);",
        "    var rescalingFactor = Math.sqrt(targetTemperature / outsideTemperature);",
        "    for (var i = 0; i < outsideAtoms.length; i++) {",
        "      var props = getAtomProperties(outsideAtoms[i]);",
        "      var newVx = props.vx * rescalingFactor;",
        "      var newVy = props.vy * rescalingFactor;",
        "      setAtomProperties(outsideAtoms[i], { vx: newVx, vy: newVy });",
        "    }",
        "  });",
        "});"
      ],
      "viewOptions": {
        "controlButtons": "play_reset"
      }
    }
  ],
  "parameters": [
    {
      "name": "lightSourceEnabled",
      "initialValue": true,
      "onChange": [
        "if (value) {",
        "  turnOnLightSource();",
        "} else {",
        "  turnOffLightSource();",
        "}"
      ]
    },
    {
      "name": "slowMotion",
      "initialValue": false,
      "onChange": [
        "if (value) {",
        "  set('timeStep', 0.18);",
        "} else {",
        "  set('timeStep', 0.4180000126361847);",
        "}"
      ]
    },
    {
      "name": "outsideAirTemperature",
      "initialValue": 1000
    },
    {
      "name": "insideWallAtoms",
      "initialValue": []
    },
    {
      "name": "outsideWallAtoms",
      "initialValue": []
    }
  ],
  "outputs": [
    {
      "name": "insideAirAtoms",
      "value": [
        "var insideAirLeftEdge = 0.6;",
        "var insideAirWidth = get('width')/2 - 0.1 - insideAirLeftEdge;",
        "return atomsWithinRect(insideAirLeftEdge,0,insideAirWidth, get('height'));"
      ]
    },
    {
      "name": "outsideAirAtoms",
      "value": [
        "// Try including part of the wall",
        "var outsideAirLeftEdge = get('width')/2 + 0.6;",
        "var outsideAirWidth = get('width') - outsideAirLeftEdge;",
        "return atomsWithinRect(outsideAirLeftEdge,0,outsideAirWidth, get('height'));"
      ]
    },
    {
      "name": "insideWallAtomsTemp",
      "value": [
        "return getTemperatureOfAtoms(get('insideWallAtoms'));"
      ],
      "label": "Temperature of Molecules in Inside Wall",
      "unitAbbreviation": "°C"
    },
    {
      "name": "outsideWallAtomsTemp",
      "value": [
        "return getTemperatureOfAtoms(get('outsideWallAtoms'));"
      ],
      "label": "Temperature of Molecules in Outside Wall",
      "unitAbbreviation": "°C"
    },
    {
      "name": "insideAirAtomsTemp",
      "value": [
        "return getTemperatureOfAtoms(get('insideAirAtoms'));"
      ],
      "label": "Temperature of Molecules of the Inside Air",
      "unitAbbreviation": "°C"
    },
    {
      "name": "outsideAirAtomsTemp",
      "value": [
        "return getTemperatureOfAtoms(get('outsideAirAtoms'));"
      ],
      "label": "Temperature of Molecules of the Inside Air",
      "unitAbbreviation": "°C"
    }

  ],
  "filteredOutputs": [
    {
      "name": "insideWallAverageTemperature",
      "property": "insideWallAtomsTemp",
      "type": "RunningAverage",
      "period": 2500,
      "label": "Average Temperature",
      "unitType": "temperature",
      "unitAbbreviation": "°C"
    },
    {
      "name": "outsideWallAverageTemperature",
      "property": "outsideWallAtomsTemp",
      "type": "RunningAverage",
      "period": 2500,
      "label": "Average Temperature",
      "unitType": "temperature",
      "unitAbbreviation": "°C"
    },
    {
      "name": "insideAirAverageTemperature",
      "property": "insideAirAtomsTemp",
      "type": "RunningAverage",
      "period": 2500,
      "label": "Average Temperature",
      "unitType": "temperature",
      "unitAbbreviation": "°C"
    },
    {
      "name": "outsideAirAverageTemperature",
      "property": "outsideAirAtomsTemp",
      "type": "RunningAverage",
      "period": 2500,
      "label": "Average Temperature",
      "unitType": "temperature",
      "unitAbbreviation": "°C"
    }
  ],
  "helpTips": [

  ],
  "hideExportDataControl": false,
  "components": [
    {
      "id": "select-model",
      "type": "radio",
      "orientation": "vertical",
      "label": "",
      "labelOn": "top",
      "options": [
        {
          "text": "Brick",
          "selected": true,
          "action": "loadModel('brick');"
        },
        {
          "text": "Glass",
          "action": "loadModel('glass');"
