      ],
      "disabled": false,
      "tooltip": ""
    },
    {
      "id": "text-photon-key",
      "type": "text",
      "text": "*Photons*",
      "width": "auto",
      "height": "auto",
      "tooltip": ""
    },
    {
      "id": "inside-wall-thermometer",
      "type": "barGraph",
